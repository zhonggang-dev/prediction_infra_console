[Unit]
Description=UniPat Prediction Console V2
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target prediction-infra.service

[Service]
Type=simple
Restart=always
RestartSec=5s
SuccessExitStatus=1 137 143
TimeoutStartSec=90
TimeoutStopSec=30
Environment=PREDICTION_CONSOLE_V2_BIND_ADDRESS=127.0.0.1
Environment=PREDICTION_CONSOLE_V2_PORT=13001
EnvironmentFile=-/etc/prediction-console-v2/service.env
ExecStartPre=-/usr/bin/docker rm -f prediction-console-v2
ExecStart=/usr/bin/docker run --name prediction-console-v2 --network host --env-file /etc/prediction-console-v2/env --env PREDICTION_CONSOLE_V2_BIND_ADDRESS=${PREDICTION_CONSOLE_V2_BIND_ADDRESS} --env PREDICTION_CONSOLE_V2_PORT=${PREDICTION_CONSOLE_V2_PORT} --security-opt no-new-privileges --cap-drop ALL --read-only --tmpfs /app/.wrangler:rw,nosuid,nodev,noexec,size=16m --tmpfs /app/.wrangler-v2:rw,nosuid,nodev,noexec,size=16m --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m --log-opt max-size=10m --log-opt max-file=3 prediction-console-v2:current pnpm start:v2
ExecStop=/usr/bin/docker stop --time 20 prediction-console-v2
ExecStopPost=-/usr/bin/docker rm -f prediction-console-v2

[Install]
WantedBy=multi-user.target
