[Unit]
Description=UniPat Prediction Console
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target prediction-infra.service

[Service]
Type=simple
Restart=always
RestartSec=5s
SuccessExitStatus=1 137 143
TimeoutStartSec=90
TimeoutStopSec=30
ExecStartPre=-/usr/bin/docker rm -f prediction-console
ExecStart=/usr/bin/docker run --name prediction-console --network host --env-file /etc/prediction-console/env --security-opt no-new-privileges --cap-drop ALL --read-only --tmpfs /app/.wrangler:rw,nosuid,nodev,noexec,size=16m --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m --log-opt max-size=10m --log-opt max-file=3 prediction-console:current pnpm start -- --hostname 127.0.0.1 --port 13000
ExecStop=/usr/bin/docker stop --time 20 prediction-console
ExecStopPost=-/usr/bin/docker rm -f prediction-console

[Install]
WantedBy=multi-user.target
