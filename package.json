{
  "name": "prediction-console-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:v2": "node scripts/check-v2-port.mjs && MINIFLARE_REGISTRY_PATH=.wrangler-v2/registry WRANGLER_LOG_PATH=.wrangler-v2/wrangler.log vinext dev --hostname ${PREDICTION_CONSOLE_V2_BIND_ADDRESS:-127.0.0.1} --port ${PREDICTION_CONSOLE_V2_PORT:-13001}",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:v2": "MINIFLARE_REGISTRY_PATH=.wrangler-v2/registry WRANGLER_LOG_PATH=.wrangler-v2/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:v2": "node scripts/check-v2-port.mjs && MINIFLARE_REGISTRY_PATH=.wrangler-v2/registry WRANGLER_LOG_PATH=.wrangler-v2/wrangler.log vinext start --hostname ${PREDICTION_CONSOLE_V2_BIND_ADDRESS:-127.0.0.1} --port ${PREDICTION_CONSOLE_V2_PORT:-13001}",
    "test": "pnpm build && node --experimental-strip-types --test tests/live-risk.test.ts tests/pnl-metrics.test.ts tests/resolution-rules.test.ts tests/answer-audit.test.ts tests/topic-paths.test.ts tests/dataset-rotation.test.ts tests/redis-monitor.test.ts tests/console-v2.test.ts tests/console-downloads.test.ts tests/console-v2-foundation.test.mjs tests/backtest-platform.test.ts tests/backtest-selection.test.ts tests/backtest-form.test.ts tests/backtest-bff.test.ts tests/backtest-components.test.mjs tests/rendered-html.test.mjs tests/system-workspace.test.mjs tests/trading-workspace.test.ts tests/trading-production-styles.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "react": "19.2.6",
    "lucide-react": "0.468.0",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
