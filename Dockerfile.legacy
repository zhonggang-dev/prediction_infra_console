FROM node:24-bookworm-slim AS build

ARG PNPM_VERSION=11.19.0

RUN npm install --global "pnpm@${PNPM_VERSION}"

WORKDIR /app

COPY . .
RUN node scripts/legacy-profile.mjs prepare
RUN cd .legacy-console && pnpm install --frozen-lockfile
RUN cd .legacy-console && INIT_CWD="$PWD" WRANGLER_LOG_PATH=.wrangler/wrangler.log pnpm build

FROM node:24-bookworm-slim AS runtime

ARG PNPM_VERSION=11.19.0
ARG RELEASE_MERGE_SHA
ARG LEGACY_SOURCE_COMMIT
ARG BACKEND_BINARY_SHA256

LABEL org.opencontainers.image.source-branch="main" \
      org.opencontainers.image.revision="$RELEASE_MERGE_SHA" \
      com.unipai.release-profile="legacy" \
      com.unipai.legacy-source-commit="$LEGACY_SOURCE_COMMIT" \
      com.unipai.backend-binary-sha256="$BACKEND_BINARY_SHA256"

RUN npm install --global "pnpm@${PNPM_VERSION}"

ENV NODE_ENV=production
# Build-time frozen install owns dependencies; relocation checks may warn but
# must not trigger an install inside the read-only runtime filesystem.
ENV pnpm_config_verify_deps_before_run=warn
WORKDIR /app

# The assembled legacy source owns /app/package.json, lockfile, and matching
# node_modules instead of using the V2 dependency tree.
COPY --from=build --chown=node:node /app/.legacy-console/ /app/

USER node
EXPOSE 13000

CMD ["pnpm", "start", "--", "--hostname", "0.0.0.0", "--port", "13000"]
