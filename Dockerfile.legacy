FROM node:24-bookworm-slim AS build

ARG PNPM_VERSION=11.19.0

RUN npm install --global "pnpm@${PNPM_VERSION}"

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm legacy:build

FROM node:24-bookworm-slim AS runtime

ARG PNPM_VERSION=11.19.0
ARG RELEASE_MERGE_SHA
ARG LEGACY_SOURCE_COMMIT
ARG BACKEND_BINARY_SHA256

LABEL org.opencontainers.image.source-branch="main" \
      org.opencontainers.image.revision="$RELEASE_MERGE_SHA" \
      com.unipai.release-profile="legacy" \
      com.unipai.legacy-source-commit="$LEGACY_SOURCE_COMMIT" \
      com.unipai.backend-binary-sha256="$BACKEND_BINARY_SHA256"

RUN npm install --global "pnpm@${PNPM_VERSION}"

ENV NODE_ENV=production
WORKDIR /app

# The assembled legacy source owns /app/package.json and its start script;
# dependencies remain the single root install from the build stage.
COPY --from=build --chown=node:node /app/.legacy-console/ /app/
COPY --from=build --chown=node:node /app/node_modules/ /app/node_modules/

USER node
EXPOSE 13000

CMD ["pnpm", "start", "--", "--hostname", "0.0.0.0", "--port", "13000"]
